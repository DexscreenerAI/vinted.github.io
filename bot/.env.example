# Boîte mail dédiée qui reçoit les alertes Leboncoin, eBay, Interenchères, Kleinanzeigen (Gmail : créer un « mot de passe d'application »)
IMAP_HOST=imap.gmail.com
IMAP_USER=mon.adresse.alertes@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_FOLDER=INBOX
# Facultatif : expéditeur supplémentaire (ex. vos transferts) ; les sites connus sont reconnus d'office
IMAP_FROM=
# Ne lire que les emails non lus des N derniers jours (0 = sans limite)
IMAP_SINCE_DAYS=7

# Mot de passe de la page web (obligatoire si la page est en ligne)
WEB_PASSWORD=

# Facultatif : bot Telegram (créé avec @BotFather) + votre identifiant de chat (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
