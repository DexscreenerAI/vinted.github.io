# Boîte mail dédiée qui reçoit les alertes Leboncoin (Gmail : créer un « mot de passe d'application »)
IMAP_HOST=imap.gmail.com
IMAP_USER=mon.adresse.alertes@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_FOLDER=INBOX
