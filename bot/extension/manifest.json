{
  "manifest_version": 3,
  "name": "Chasseur d'affaires",
  "version": "1.6.0",
  "description": "Analyse automatiquement les annonces Leboncoin, Vinted et eBay que vous consultez et affiche leur rentabilité à la revente (avec le logiciel Chasseur d'affaires lancé).",
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chasseur d'affaires",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.leboncoin.fr/*",
        "https://www.vinted.fr/*",
        "https://www.ebay.fr/*",
        "https://www.ebay.de/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "tour-next": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Tournée : recherche suivante"
    },
    "tour-prev": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "Tournée : recherche précédente"
    }
  }
}